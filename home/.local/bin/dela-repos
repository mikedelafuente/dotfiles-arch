#!/bin/bash
# Pick a repo under ~/repos with fzf and print its path.
# Usage:
#   cd "$(dela-repos)"      # or the r alias from ~/.bashrc
#   dela-repos <filter>     # pre-seed the fzf query
#
# Searches ~/repos two levels deep (owner/repo layouts included) and prefers
# directories that contain a .git; also lists non-git top-level folders as
# browse targets (e.g. an owner folder that just groups other repos).

set -euo pipefail

_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
source "$_LIB_DIR/dotfiles-arch-lib.sh"

ROOT_DIR="${REPOS_DIR:-$HOME/repos}"

if [[ ! -d "$ROOT_DIR" ]]; then
  echo "No repo directory at $ROOT_DIR (set REPOS_DIR to override)." >&2
  exit 1
fi

list_repos() {
  list_git_repos_under "$ROOT_DIR"
  # Also list non-git top-level folders as browse targets (e.g. an owner
  # folder that just groups other repos one level down).
  find "$ROOT_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
}

CANDIDATES="$(list_repos | sort -u)"

if [[ -z "$CANDIDATES" ]]; then
  echo "No repositories found under $ROOT_DIR" >&2
  exit 1
fi

if ! command -v fzf &>/dev/null; then
  echo "fzf is not installed. Directories under $ROOT_DIR:" >&2
  echo "$CANDIDATES" >&2
  exit 1
fi

if [[ ! -t 0 ]] || [[ ! -t 2 ]]; then
  echo "dela-repos needs an interactive terminal (use: cd \"\$(dela-repos)\")." >&2
  exit 1
fi

SELECTED="$(printf '%s\n' "$CANDIDATES" \
  | sed "s|^$HOME/|~/|" \
  | fzf --height=40% --layout=reverse --border --prompt='repo> ' --query="${1:-}" --select-1 --exit-0)"

if [[ -z "$SELECTED" ]]; then
  # Nothing picked: stay where we are so `cd "$(dela-repos)"` is a no-op.
  pwd
  exit 0
fi

printf '%s\n' "${SELECTED/#\~\//$HOME/}"
