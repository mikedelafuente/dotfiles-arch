#!/bin/bash

# zed-agent-init - Zed's agent.terminal_init_command (config/zed/settings.json).
#
# Resolves the same DEFAULT_HARNESS as `code` (see home/.local/bin/code and
# resolve_or_prompt_default_harness in dotfiles-arch-lib.sh), so a Zed
# Terminal Thread starts the same agent CLI as the tmux `code` agent pane —
# including the same graceful fallback if the saved default's CLI is stale.
# Zed runs this as if typed into a fresh Terminal Thread shell, in the
# current project's directory, so no cd/exec bookkeeping is needed here.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/dotfiles-arch-lib.sh"

if HARNESS_BIN="$(resolve_or_prompt_default_harness)"; then
    exec "$HARNESS_BIN"
fi

echo "No agent harness CLI installed (${KNOWN_HARNESSES[*]})."
echo "Run scripts/setup-claude.sh, scripts/setup-codex.sh, or scripts/setup-opencode.sh, then scripts/setup-code.sh to pick a default."
exec "${SHELL:-bash}"
