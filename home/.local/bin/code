#!/bin/bash

# code - Open a tmux development session with Neovim (+ agent pane) for a git repo
# Usage: code [--force|-f] [--agent <harness>] [directory]
#   directory:    Path to project directory (defaults to current directory)
#   --force:      Open even when the directory is not a git repository
#   --agent:      Start an agent harness (see KNOWN_HARNESSES in dotfiles-arch-lib.sh,
#                 e.g. claude, codex, opencode) in the split pane; defaults to
#                 DEFAULT_HARNESS from setup-code.sh, falling back to whichever
#                 harness is actually installed if that saved choice is stale
#                 (a plain shell if none are installed)
#
# - Always kills and recreates a session named after the target directory (fresh state).
# - Window "code": Neovim (left, ~75%) + the default (or --agent) agent CLI / plain shell (right, ~25%)
# - Window "lazygit" (git repos only, when lazygit is installed)
# - Window "console": plain shell in the project directory (run commands without leaving the session)
# - Focus lands on the agent pane in the "code" window
# - Outside tmux: attaches in Kitty (or the current terminal); inside tmux: switches client

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/dotfiles-arch-lib.sh"

FORCE=0
AGENT=""
TARGET_DIR="."

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force|-f)
            FORCE=1
            shift
            ;;
        --agent)
            AGENT="${2:-}"
            if [[ -z "$AGENT" ]]; then
                echo "Error: --agent requires a value (${KNOWN_HARNESSES[*]})"
                exit 1
            fi
            shift 2
            ;;
        -h|--help)
            cat <<EOF
Usage: code [--force|-f] [--agent <harness>] [directory]

  --agent <harness>   Start that agent CLI in the split pane (one of: ${KNOWN_HARNESSES[*]})
                      (default: DEFAULT_HARNESS from setup-code.sh)
  --force              Allow a non-git directory
EOF
            exit 0
            ;;
        *)
            TARGET_DIR="$1"
            shift
            ;;
    esac
done

if [[ -n "$AGENT" ]]; then
    is_known=0
    for known in "${KNOWN_HARNESSES[@]}"; do
        [[ "$AGENT" == "$known" ]] && is_known=1 && break
    done
    if [[ "$is_known" -ne 1 ]]; then
        echo "Error: --agent must be one of: ${KNOWN_HARNESSES[*]} (got: $AGENT)"
        exit 1
    fi
    if ! command -v "$AGENT" &>/dev/null; then
        echo "Error: $AGENT is not installed"
        exit 1
    fi
fi

# No --agent given: fall back to the DEFAULT_HARNESS chosen during
# setup-code.sh. If that saved choice is stale/unset, resolve_or_prompt
# picks the sole installed harness silently, asks when several are
# installed, or returns 1 when none are (plain shell pane).
if [[ -z "$AGENT" ]] && DEFAULT_HARNESS_BIN="$(resolve_or_prompt_default_harness)"; then
    AGENT="$DEFAULT_HARNESS_BIN"
fi

TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

if [[ ! -d "$TARGET_DIR/.git" ]] && [[ "$FORCE" -eq 0 ]]; then
    echo "Error: $TARGET_DIR is not a git repository"
    echo "Use 'code --force' to open it anyway."
    exit 1
fi

if ! command -v tmux &>/dev/null; then
    echo "Error: tmux is not installed. Run scripts/setup-code.sh first."
    exit 1
fi

if ! command -v nvim &>/dev/null; then
    echo "Error: nvim is not installed. Run scripts/setup-neovim.sh first."
    exit 1
fi

# Tmux-safe session name derived from the directory basename; see
# tmux_session_name_for in dotfiles-arch-lib.sh (also used by nvim-reveal-edit
# to find this session's Neovim socket).
SESSION_NAME="$(tmux_session_name_for "$TARGET_DIR")"

# Resolve the command to start in the agent pane, if any. Harness ids double
# as their CLI binary name (see KNOWN_HARNESSES in dotfiles-arch-lib.sh).
agent_command() {
    printf '%s' "$AGENT"
}

# Kill any existing session with the same name (always start fresh).
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Killing existing session '$SESSION_NAME'"
    tmux kill-session -t "$SESSION_NAME"
fi

echo "Creating tmux session '$SESSION_NAME' for $TARGET_DIR"

# Neovim listens on a socket named after SESSION_NAME so nvim-reveal-edit
# (the Claude/Codex PostToolUse hook) can find this pane.
NVIM_SOCKET="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-arch-nvim-${SESSION_NAME}.sock"
rm -f "$NVIM_SOCKET"

NVIM_PANE="$(tmux new-session -d -s "$SESSION_NAME" -c "$TARGET_DIR" -n code -P -F '#{pane_id}')"
tmux send-keys -t "$NVIM_PANE" "nvim --listen '$NVIM_SOCKET' ." C-m

AGENT_PANE="$(tmux split-window -t "$NVIM_PANE" -h -p 25 -c "$TARGET_DIR" -P -F '#{pane_id}')"
if [[ -n "$AGENT" ]]; then
    tmux send-keys -t "$AGENT_PANE" "$(agent_command)" C-m
    echo "Started $AGENT in pane $AGENT_PANE"
fi

if [[ -d "$TARGET_DIR/.git" ]]; then
    if command -v lazygit &>/dev/null; then
        tmux new-window -t "$SESSION_NAME" -n lazygit -c "$TARGET_DIR"
        tmux send-keys -t "$SESSION_NAME:lazygit" "lazygit" C-m
    else
        echo "Note: lazygit is not installed; skipping the 'lazygit' window"
    fi
fi

tmux new-window -t "$SESSION_NAME" -n console -c "$TARGET_DIR"

tmux select-window -t "$SESSION_NAME:code"
tmux select-pane -t "$AGENT_PANE"

# Already in tmux: just switch the client over.
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION_NAME"
    exit 0
fi

# Already inside a Kitty window (but not in tmux): attach in place.
if [[ -n "${KITTY_WINDOW_ID:-}" ]] || [[ "${TERM}" == *kitty* ]]; then
    exec tmux attach-session -t "$SESSION_NAME"
fi

# Plain terminal: launch Kitty attached to the session, killing it on exit.
if command -v kitty &>/dev/null; then
    exec kitty -e bash -c "tmux attach-session -t '$SESSION_NAME'; tmux kill-session -t '$SESSION_NAME' 2>/dev/null || true"
fi

exec tmux attach-session -t "$SESSION_NAME"
