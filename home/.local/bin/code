#!/bin/bash

# code - Open a tmux development session with Neovim (+ agent pane) for a git repo
# Usage: code [--force|-f] [--agent cursor|claude] [--workspace <name-or-path>] [directory]
#   directory:    Path to project directory (defaults to current directory)
#   --force:      Open even when the directory is not a git repository
#   --agent:      Start an agent (cursor or claude) in the split pane; defaults to
#                 DEFAULT_AGENT from setup-code.sh (a plain shell if neither is installed)
#   --workspace:  Cursor Agent saved workspace name or path (requires --agent cursor)
#
# - Always kills and recreates a session named after the target directory (fresh state).
# - Window "code": Neovim (left, ~75%) + the default (or --agent) agent CLI / plain shell (right, ~25%)
# - Window "lazygit" (git repos only, when lazygit is installed)
# - Outside tmux: attaches in Kitty (or the current terminal); inside tmux: switches client

set -euo pipefail

FORCE=0
AGENT=""
WORKSPACE=""
TARGET_DIR="."

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force|-f)
            FORCE=1
            shift
            ;;
        --agent)
            AGENT="${2:-}"
            if [[ -z "$AGENT" ]]; then
                echo "Error: --agent requires a value (cursor or claude)"
                exit 1
            fi
            shift 2
            ;;
        --workspace)
            WORKSPACE="${2:-}"
            if [[ -z "$WORKSPACE" ]]; then
                echo "Error: --workspace requires a value (saved name or path)"
                exit 1
            fi
            shift 2
            ;;
        -h|--help)
            cat <<'EOF'
Usage: code [--force|-f] [--agent cursor|claude] [--workspace <name-or-path>] [directory]

  --agent cursor|claude   Start that agent CLI in the split pane
                          (default: DEFAULT_AGENT from setup-code.sh)
  --workspace NAME|PATH   Cursor Agent workspace (requires --agent cursor)
  --force                 Allow a non-git directory
EOF
            exit 0
            ;;
        *)
            TARGET_DIR="$1"
            shift
            ;;
    esac
done

if [[ -n "$AGENT" ]] && [[ "$AGENT" != "cursor" ]] && [[ "$AGENT" != "claude" ]]; then
    echo "Error: --agent must be 'cursor' or 'claude' (got: $AGENT)"
    exit 1
fi

# No --agent given: fall back to the DEFAULT_AGENT chosen during setup-code.sh
# (whichever agent CLI is actually installed still wins if the saved choice is stale).
if [[ -z "$AGENT" ]]; then
    BOOTSTRAP_CONFIG="$HOME/.config/dotfiles-arch/.dotfiles_bootstrap_config"
    DEFAULT_AGENT=""
    if [[ -r "$BOOTSTRAP_CONFIG" ]]; then
        # shellcheck source=/dev/null
        DEFAULT_AGENT="$(source "$BOOTSTRAP_CONFIG" && printf '%s' "${DEFAULT_AGENT:-}")" 2>/dev/null || DEFAULT_AGENT=""
    fi
    if [[ "$DEFAULT_AGENT" == "cursor" ]] && { command -v cursor-agent &>/dev/null || command -v agent &>/dev/null; }; then
        AGENT="cursor"
    elif [[ "$DEFAULT_AGENT" == "claude" ]] && command -v claude &>/dev/null; then
        AGENT="claude"
    fi
fi

if [[ -n "$WORKSPACE" ]]; then
    if [[ -z "$AGENT" ]]; then
        echo "Error: --workspace requires --agent cursor"
        exit 1
    fi
    if [[ "$AGENT" != "cursor" ]]; then
        echo "Error: --workspace is only supported for Cursor Agent (Claude has no workspace flag)"
        exit 1
    fi
fi

TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

if [[ ! -d "$TARGET_DIR/.git" ]] && [[ "$FORCE" -eq 0 ]]; then
    echo "Error: $TARGET_DIR is not a git repository"
    echo "Use 'code --force' to open it anyway."
    exit 1
fi

if ! command -v tmux &>/dev/null; then
    echo "Error: tmux is not installed. Run scripts/setup-code.sh first."
    exit 1
fi

if ! command -v nvim &>/dev/null; then
    echo "Error: nvim is not installed. Run scripts/setup-neovim.sh first."
    exit 1
fi

# Generate a tmux-safe session name from the directory basename (no dots,
# spaces, or colons); fall back to a hash if that leaves nothing usable.
SESSION_NAME=$(basename "$TARGET_DIR" | tr '.' '_' | tr ' ' '_' | tr ':' '_')
if [[ -z "$SESSION_NAME" || "$SESSION_NAME" =~ ^_+$ ]]; then
    SESSION_NAME="dev_$(echo "$TARGET_DIR" | md5sum | cut -c1-8)"
fi

# Resolve the command to start in the agent pane, if any.
agent_command() {
    case "$AGENT" in
        cursor)
            local bin="cursor-agent"
            command -v cursor-agent &>/dev/null || bin="agent"
            if [[ -n "$WORKSPACE" ]]; then
                printf '%s --workspace %q' "$bin" "$WORKSPACE"
            else
                printf '%s' "$bin"
            fi
            ;;
        claude)
            printf 'claude'
            ;;
    esac
}

# Kill any existing session with the same name (always start fresh).
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Killing existing session '$SESSION_NAME'"
    tmux kill-session -t "$SESSION_NAME"
fi

echo "Creating tmux session '$SESSION_NAME' for $TARGET_DIR"

NVIM_PANE="$(tmux new-session -d -s "$SESSION_NAME" -c "$TARGET_DIR" -n code -P -F '#{pane_id}')"
tmux send-keys -t "$NVIM_PANE" "nvim ." C-m

AGENT_PANE="$(tmux split-window -t "$NVIM_PANE" -h -p 25 -c "$TARGET_DIR" -P -F '#{pane_id}')"
if [[ -n "$AGENT" ]]; then
    tmux send-keys -t "$AGENT_PANE" "$(agent_command)" C-m
    echo "Started $AGENT in pane $AGENT_PANE"
fi

tmux select-pane -t "$NVIM_PANE"

if [[ -d "$TARGET_DIR/.git" ]]; then
    if command -v lazygit &>/dev/null; then
        tmux new-window -t "$SESSION_NAME" -n lazygit -c "$TARGET_DIR"
        tmux send-keys -t "$SESSION_NAME:lazygit" "lazygit" C-m
    else
        echo "Note: lazygit is not installed; skipping the 'lazygit' window"
    fi
fi

tmux select-window -t "$SESSION_NAME:code"

# Already in tmux: just switch the client over.
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION_NAME"
    exit 0
fi

# Already inside a Kitty window (but not in tmux): attach in place.
if [[ -n "${KITTY_WINDOW_ID:-}" ]] || [[ "${TERM}" == *kitty* ]]; then
    exec tmux attach-session -t "$SESSION_NAME"
fi

# Plain terminal: launch Kitty attached to the session, killing it on exit.
if command -v kitty &>/dev/null; then
    exec kitty -e bash -c "tmux attach-session -t '$SESSION_NAME'; tmux kill-session -t '$SESSION_NAME' 2>/dev/null || true"
fi

exec tmux attach-session -t "$SESSION_NAME"
