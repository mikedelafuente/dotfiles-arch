#!/bin/bash
# Daily routine — refresh git repos and system packages.
#
# Edit DAILY_STEPS below to add or reorder tasks. Each name must be on PATH
# (~/.local/bin). Missing commands are skipped with a message.
#
# Default: dfa-update-repos, then dfa-update-system (day-to-day pacman + yay), then
# dfa-update-npm-clis (npm update -g for claude/codex/pi — opencode is pacman-managed
# and already covered by dfa-update-system), then dfa-sync-skills (relink personal
# skills from dotfiles-arch), then dfa-sync-rules (relink personal Cursor rules from
# dotfiles-arch), then dfa-sync-harness-agents (sync local Ollama models into
# Codex/opencode's model lists).
# If dfa-update-repos pulls new dotfiles-arch commits, dfa-daily runs dfa-sync-dotfiles
# itself (setup scripts + re-link) right away, then restarts the whole
# routine from the top so the remaining steps run against the freshly-synced
# scripts — capped at one restart per invocation.
#
# For weekly maintenance on top of this (orphan cleanup, a forced package
# update pass), see dfa-weekly, which runs this script first.
#
# Usage: dfa-daily [args…]
#   Args are forwarded to every step (e.g. dfa-daily --yes).

set -uo pipefail

_DAILY_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_DAILY_LIB_DIR="$(cd -- "$(dirname -- "$_DAILY_SELF")" &>/dev/null && pwd)"
if [[ -r "$_DAILY_LIB_DIR/dotfiles-arch-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_DAILY_LIB_DIR/dotfiles-arch-lib.sh"
fi

DAILY_STEPS=(
  dfa-update-repos
  dfa-update-system
  dfa-update-npm-clis
  dfa-sync-skills
  dfa-sync-rules
  dfa-sync-harness-agents
)

usage() {
  cat <<'EOF'
Usage: dfa-daily [args…]

Run the daily routine steps in order. Edit DAILY_STEPS in this script to
customize. Steps not on PATH are skipped.

Default steps:
  dfa-update-repos    git pull under ~/repos
  dfa-update-system   guarded pacman + yay update
  dfa-update-npm-clis npm update -g for claude/codex/pi (opencode is pacman-managed)
  dfa-sync-skills     relink skills from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-rules      relink Cursor rules from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-harness-agents  sync local Ollama models into Codex/opencode's model lists

If dfa-update-repos pulls new dotfiles-arch commits, dfa-sync-dotfiles runs
automatically and the whole routine restarts from the top (capped at one
restart per invocation) so the remaining steps see the synced scripts.

For weekly maintenance on top of this (orphan cleanup, a forced package
update pass), see dfa-weekly.

Example:
  dfa-daily --yes   non-interactive system update (forwarded to dfa-update-system)
EOF
}

main() {
  local step step_status
  local -a failures=() skipped=()
  local dotfiles_arch_root="" before_sha="" after_sha=""

  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        usage
        exit 0
        ;;
    esac
  done

  if command -v resolve_dotfiles_arch &>/dev/null; then
    dotfiles_arch_root="$(resolve_dotfiles_arch 2>/dev/null || true)"
    if [[ -n "$dotfiles_arch_root" ]]; then
      before_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
    fi
  fi

  for step in "${DAILY_STEPS[@]}"; do
    if ! command -v "$step" &>/dev/null; then
      printf 'dfa-daily: skip %s (not on PATH)\n' "$step" >&2
      skipped+=("$step")
      continue
    fi

    printf '\n==> %s\n' "$step"
    if "$step" "$@"; then
      step_status=0
    else
      step_status=$?
      printf 'dfa-daily: %s failed (exit %s)\n' "$step" "$step_status" >&2
      failures+=("$step")
    fi

    if [[ "$step" == "dfa-update-repos" && "$step_status" -eq 0 && -n "$dotfiles_arch_root" ]]; then
      after_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
      if [[ -n "$before_sha" && -n "$after_sha" && "$before_sha" != "$after_sha" ]]; then
        printf '\ndfa-daily: dotfiles-arch updated (%s..%s)\n' "${before_sha:0:7}" "${after_sha:0:7}"
        if [[ "${_DAILY_RESTARTED:-0}" == 1 ]]; then
          printf 'dfa-daily: already restarted once this run — continuing without another restart\n' >&2
        elif ! command -v dfa-sync-dotfiles &>/dev/null; then
          printf 'dfa-daily: skip dfa-sync-dotfiles (not on PATH) — run it manually to apply setup script changes\n' >&2
          skipped+=("dfa-sync-dotfiles")
        else
          printf '\n==> dfa-sync-dotfiles\n'
          if dfa-sync-dotfiles "$@"; then
            printf 'dfa-daily: restarting to pick up synced changes\n'
            export _DAILY_RESTARTED=1
            exec "$_DAILY_SELF" "$@"
          else
            printf 'dfa-daily: dfa-sync-dotfiles failed (exit %s) — continuing with remaining steps\n' "$?" >&2
            failures+=("dfa-sync-dotfiles")
          fi
        fi
      fi
    fi
  done

  printf '\n'
  if ((${#skipped[@]})); then
    printf 'dfa-daily: skipped (not on PATH): %s\n' "${skipped[*]}"
  fi
  if ((${#failures[@]})); then
    printf 'dfa-daily: finished with failures: %s\n' "${failures[*]}" >&2
    exit 1
  fi
  printf 'dfa-daily: done\n'
}

main "$@"
