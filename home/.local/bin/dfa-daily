#!/bin/bash
# Daily routine — refresh git repos and system packages.
#
# Edit DAILY_STEPS below to add or reorder tasks. Each name must be on PATH
# (~/.local/bin). Missing required repository steps fail; custom steps may skip.
#
# Obtain source changes, stage/merge, validate and activate a complete generation
# before migrations and dependent maintenance. Conflicts/source failures stop here.
# Restart into changed helpers at most once. Native/app update owners keep their
# existing cooldown and failure rules. --dry-run performs no writes/acquisition.
# Usage: dfa-daily [args…]; generic flags go to dependent maintenance steps.

set -uo pipefail

_DAILY_SELF="$(readlink -f "/proc/$$/fd/255" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_DAILY_LIB_DIR="$(cd -- "$(dirname -- "$_DAILY_SELF")" &>/dev/null && pwd)"
if [[ -r "$_DAILY_LIB_DIR/dotfiles-arch-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_DAILY_LIB_DIR/dotfiles-arch-lib.sh"
fi

DAILY_STEPS=(
  dfa-update-repos
  dfa-migrate
  dfa-update-system
  dfa-update-npm-clis
  dfa-sync-skills
  dfa-sync-extensions
  dfa-sync-rules
  dfa-sync-harness-agents
)

usage() {
  cat <<'EOF'
Usage: dfa-daily [args…]

Run the daily routine steps in order. Edit DAILY_STEPS in this script to
customize. Missing repository steps fail; custom steps not on PATH are skipped.

Default steps:
  dfa-update-repos    git pull under ~/repos
  dfa-migrate         run pending dotfiles-arch schema migrations
  dfa-update-system   native Arch/APT update (24h cooldown; --force overrides)
  dfa-update-npm-clis npm-owned claude/codex/opencode; native Claude uses claude update
  dfa-sync-skills     relink skills from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-extensions relink Pi extensions from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-rules      relink Cursor rules from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-harness-agents  sync local Ollama models into Codex/opencode's model lists

Repository/source acquisition and safe deployment run first. Failure blocks
dependent steps; a changed generation restarts this routine at most once.
--dry-run reports the source/deployment plan without acquisition or writes.

For weekly maintenance on top of this (orphan cleanup, a forced package
update pass), see dfa-weekly.

Example:
  dfa-daily --yes   non-interactive system update (forwarded to dfa-update-system)
EOF
}

main() {
  local step root before after status=0
  local -a failures=() skipped=()
  root="$(resolve_dotfiles_arch)" || return 1
  # Establish the supported host and real user home before acquisition/deployment.
  # shellcheck source=/dev/null
  source "$root/scripts/dotheader.sh"
  set +e
  for arg in "$@"; do
    case "$arg" in
      -h|--help) usage; return 0 ;;
      --dry-run)
        root="$(resolve_dotfiles_arch)" || return 1
        if [[ -L "$USER_HOME_DIR/.local/share/workstation/config" ]]; then
          python3 "$root/scripts/deployment.py" update --dry-run
        else
          python3 "$root/scripts/deployment.py" update --source "$root" --dry-run
        fi
        return $? ;;
    esac
  done
  root="$(resolve_dotfiles_arch)" || return 1
  # Refresh configured repositories first, including extra rules/skills sources.
  if [[ "${_DAILY_RESTARTED:-0}" != 1 ]]; then
    command -v dfa-update-repos &>/dev/null || return 1
    dfa-update-repos || return 1
  fi
  # Source acquisition/deployment is a required gate before dependent steps.
  before="$(readlink -f "$USER_HOME_DIR/.local/share/workstation/config" 2>/dev/null || true)"
  if [[ "${_DAILY_RESTARTED:-0}" == 1 ]]; then
    [[ "$before" == "$root" ]] || return 1
  elif [[ -L "$USER_HOME_DIR/.local/share/workstation/config" ]]; then
    python3 "$root/scripts/deployment.py" update || return 1
  else
    python3 "$root/scripts/deployment.py" update --source "$root" || return 1
  fi
  if [[ "${_DAILY_RESTARTED:-0}" == 1 ]]; then
    after="$root"
  else
    after="$(readlink -f "$USER_HOME_DIR/.local/share/workstation/config")" || return 1
  fi
  if [[ "$before" != "$after" && "${_DAILY_RESTARTED:-0}" != 1 ]]; then
    export _DAILY_RESTARTED=1
    exec "$after/home/.local/bin/dfa-daily" "$@"
  fi
  root="$after"
  # shellcheck source=/dev/null
  source "$root/scripts/dotheader.sh"
  set +e
  for step in "${DAILY_STEPS[@]}"; do
    if ! command -v "$step" &>/dev/null; then
      if [[ -f "$root/home/.local/bin/$step" ]]; then
        failures+=("$step")
      else
        skipped+=("$step")
      fi
      continue
    fi
    printf '\n==> %s\n' "$step"
    [[ "$step" != dfa-update-repos ]] || continue
    "$step" "$@"
    status=$?
    if ((status)); then
      failures+=("$step")
      # A failed migration blocks all subsequent runtime mutation steps.
      [[ "$step" != dfa-migrate ]] || break
    fi
  done
  if ((${#skipped[@]})); then printf 'dfa-daily: skipped: %s\n' "${skipped[*]}"; fi
  if ((${#failures[@]})); then
    printf 'dfa-daily: failures: %s\n' "${failures[*]}" >&2
    return 1
  fi
  printf 'dfa-daily: done\n'
}

main "$@"
