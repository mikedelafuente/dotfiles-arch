#!/bin/bash
# Morning routine — refresh git repos and system packages.
#
# Edit MORNING_STEPS below to add or reorder tasks. Each name must be on PATH
# (~/.local/bin). Missing commands are skipped with a message.
#
# Default: dfa-update-repos, then dfa-update-system (day-to-day pacman + yay), then
# dfa-sync-skills (relink personal skills from dotfiles-arch), then dfa-sync-rules
# (relink personal Cursor rules from dotfiles-arch).
# If dfa-update-repos pulls new dotfiles-arch commits, dfa-morning runs dfa-sync-dotfiles
# itself (setup scripts + re-link) right away, then restarts the whole
# routine from the top so the remaining steps run against the freshly-synced
# scripts — capped at one restart per invocation.
#
# Usage: dfa-morning [args…]
#   Args are forwarded to every step (e.g. dfa-morning --yes).

set -uo pipefail

_MORNING_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_MORNING_LIB_DIR="$(cd -- "$(dirname -- "$_MORNING_SELF")" &>/dev/null && pwd)"
if [[ -r "$_MORNING_LIB_DIR/dotfiles-arch-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_MORNING_LIB_DIR/dotfiles-arch-lib.sh"
fi

MORNING_STEPS=(
  dfa-update-repos
  dfa-update-system
  dfa-sync-skills
  dfa-sync-rules
)

usage() {
  cat <<'EOF'
Usage: dfa-morning [args…]

Run the morning routine steps in order. Edit MORNING_STEPS in this script to
customize. Steps not on PATH are skipped.

Default steps:
  dfa-update-repos    git pull under ~/repos
  dfa-update-system   guarded pacman + yay update
  dfa-sync-skills     relink skills from dotfiles-arch + dfa-sync-sources extras
  dfa-sync-rules      relink Cursor rules from dotfiles-arch + dfa-sync-sources extras

If dfa-update-repos pulls new dotfiles-arch commits, dfa-sync-dotfiles runs
automatically and the whole routine restarts from the top (capped at one
restart per invocation) so the remaining steps see the synced scripts.

Example:
  dfa-morning --yes   non-interactive system update (forwarded to dfa-update-system)
EOF
}

main() {
  local step step_status
  local -a failures=() skipped=()
  local dotfiles_arch_root="" before_sha="" after_sha=""

  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        usage
        exit 0
        ;;
    esac
  done

  if command -v resolve_dotfiles_arch &>/dev/null; then
    dotfiles_arch_root="$(resolve_dotfiles_arch 2>/dev/null || true)"
    if [[ -n "$dotfiles_arch_root" ]]; then
      before_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
    fi
  fi

  for step in "${MORNING_STEPS[@]}"; do
    if ! command -v "$step" &>/dev/null; then
      printf 'dfa-morning: skip %s (not on PATH)\n' "$step" >&2
      skipped+=("$step")
      continue
    fi

    printf '\n==> %s\n' "$step"
    if "$step" "$@"; then
      step_status=0
    else
      step_status=$?
      printf 'dfa-morning: %s failed (exit %s)\n' "$step" "$step_status" >&2
      failures+=("$step")
    fi

    if [[ "$step" == "dfa-update-repos" && "$step_status" -eq 0 && -n "$dotfiles_arch_root" ]]; then
      after_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
      if [[ -n "$before_sha" && -n "$after_sha" && "$before_sha" != "$after_sha" ]]; then
        printf '\ndfa-morning: dotfiles-arch updated (%s..%s)\n' "${before_sha:0:7}" "${after_sha:0:7}"
        if [[ "${_MORNING_RESTARTED:-0}" == 1 ]]; then
          printf 'dfa-morning: already restarted once this run — continuing without another restart\n' >&2
        elif ! command -v dfa-sync-dotfiles &>/dev/null; then
          printf 'dfa-morning: skip dfa-sync-dotfiles (not on PATH) — run it manually to apply setup script changes\n' >&2
          skipped+=("dfa-sync-dotfiles")
        else
          printf '\n==> dfa-sync-dotfiles\n'
          if dfa-sync-dotfiles "$@"; then
            printf 'dfa-morning: restarting to pick up synced changes\n'
            export _MORNING_RESTARTED=1
            exec "$_MORNING_SELF" "$@"
          else
            printf 'dfa-morning: dfa-sync-dotfiles failed (exit %s) — continuing with remaining steps\n' "$?" >&2
            failures+=("dfa-sync-dotfiles")
          fi
        fi
      fi
    fi
  done

  printf '\n'
  if ((${#skipped[@]})); then
    printf 'dfa-morning: skipped (not on PATH): %s\n' "${skipped[*]}"
  fi
  if ((${#failures[@]})); then
    printf 'dfa-morning: finished with failures: %s\n' "${failures[*]}" >&2
    exit 1
  fi
  printf 'dfa-morning: done\n'
}

main "$@"
