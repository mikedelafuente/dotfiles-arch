#!/usr/bin/env bash
# Rebind Super+Ctrl+Arrows for unified "push window" behavior.
#
# Pop Shell tiling and Mutter cannot share the same chords (double-fire snap-back).
# - tile-by-default true  → Pop Shell tile-move-*-global (move in layout; edge hops monitor)
# - tile-by-default false → Mutter half-snap (Left/Right) + move-to-monitor (Up/Down)
#
# Usage:
#   rebind-window-push           # apply once
#   rebind-window-push --watch   # apply, then re-apply when Super+Y toggles tiling

set -euo pipefail

POP_SCHEMA="org.gnome.shell.extensions.pop-shell"
WM_SCHEMA="org.gnome.desktop.wm.keybindings"
MUTTER_SCHEMA="org.gnome.mutter.keybindings"

CHORD_LEFT="['<Primary><Super>Left']"
CHORD_RIGHT="['<Primary><Super>Right']"
CHORD_UP="['<Primary><Super>Up']"
CHORD_DOWN="['<Primary><Super>Down']"

# Pop's Ubuntu recipe installs a per-user schema. Missing required schema/keys
# must be reported before either owner is rebound (also guards autostart).
POP_SETTINGS=(gsettings)
POP_SCHEMA_DIR="$HOME/.local/share/gnome-shell/extensions/pop-shell@system76.com/schemas"
[[ ! -f "$POP_SCHEMA_DIR/gschemas.compiled" ]] || POP_SETTINGS+=(--schemadir "$POP_SCHEMA_DIR")
POP_KEYS="$("${POP_SETTINGS[@]}" list-keys "$POP_SCHEMA" 2>/dev/null)" || {
  echo 'rebind-window-push: Pop Shell schema unavailable; run GNOME setup after installing compatible extensions' >&2
  exit 1
}
for key in tile-by-default pop-monitor-left pop-monitor-right pop-monitor-up pop-monitor-down \
    tile-move-left-global tile-move-right-global tile-move-up-global tile-move-down-global; do
  if ! grep -Fxq "$key" <<<"$POP_KEYS"; then
    printf 'rebind-window-push: required Pop Shell key unavailable: %s\n' "$key" >&2
    exit 1
  fi
done

rebind() {
  local tiling
  tiling="$("${POP_SETTINGS[@]}" get "$POP_SCHEMA" tile-by-default)"

  # Never leave pop-monitor-* on these chords (conflicts with push bindings).
  "${POP_SETTINGS[@]}" set "$POP_SCHEMA" pop-monitor-left "[]"
  "${POP_SETTINGS[@]}" set "$POP_SCHEMA" pop-monitor-right "[]"
  "${POP_SETTINGS[@]}" set "$POP_SCHEMA" pop-monitor-up "[]"
  "${POP_SETTINGS[@]}" set "$POP_SCHEMA" pop-monitor-down "[]"

  # Side-by-side monitors: geometric up/down monitor moves unused.
  gsettings set "$WM_SCHEMA" move-to-monitor-up "[]"
  gsettings set "$WM_SCHEMA" move-to-monitor-down "[]"

  if [[ "$tiling" == "true" ]]; then
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-left-global "$CHORD_LEFT"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-right-global "$CHORD_RIGHT"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-up-global "$CHORD_UP"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-down-global "$CHORD_DOWN"

    gsettings set "$MUTTER_SCHEMA" toggle-tiled-left "[]"
    gsettings set "$MUTTER_SCHEMA" toggle-tiled-right "[]"
    gsettings set "$WM_SCHEMA" move-to-monitor-left "[]"
    gsettings set "$WM_SCHEMA" move-to-monitor-right "[]"
  else
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-left-global "[]"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-right-global "[]"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-up-global "[]"
    "${POP_SETTINGS[@]}" set "$POP_SCHEMA" tile-move-down-global "[]"

    gsettings set "$MUTTER_SCHEMA" toggle-tiled-left "$CHORD_LEFT"
    gsettings set "$MUTTER_SCHEMA" toggle-tiled-right "$CHORD_RIGHT"
    gsettings set "$WM_SCHEMA" move-to-monitor-left "$CHORD_UP"
    gsettings set "$WM_SCHEMA" move-to-monitor-right "$CHORD_DOWN"
  fi
}

rebind

if [[ "${1:-}" != "--watch" ]]; then
  exit 0
fi

# gsettings monitor emits one line per change (more reliable than dconf watch's
# two-line path+value output for driving a rebind loop).
"${POP_SETTINGS[@]}" monitor "$POP_SCHEMA" tile-by-default | while read -r _; do
  rebind || true
done
