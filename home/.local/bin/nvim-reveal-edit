#!/bin/bash

# nvim-reveal-edit - PostToolUse (Claude Code) / afterFileEdit (Cursor Agent CLI) hook.
#
# Reads a hook JSON payload on stdin and, if a `code`-launched Neovim
# (home/.local/bin/code, --listen socket) is running for the edited file's
# project, reveals it there: if the file is already open in a window in the
# current tab, just focuses that window (reloading it if unmodified);
# otherwise loads the file into the first non-nvim-tree window of the
# current tab, so it lands like clicking the file in nvim-tree rather than
# spawning a new tab (and nvim-tree itself is never disturbed). No-ops
# silently whenever nothing matches, so it's safe to register globally.
#
# Payload shapes handled:
#   Claude Code PostToolUse: .tool_input.file_path (Edit/Write) or
#                             .tool_input.notebook_path (NotebookEdit)
#   Cursor afterFileEdit:    .file_path at top level

set -euo pipefail

command -v jq &>/dev/null || exit 0
command -v nvim &>/dev/null || exit 0

PAYLOAD="$(cat)"
FILE_PATH="$(jq -r '.file_path // .tool_input.file_path // .tool_input.notebook_path // empty' <<<"$PAYLOAD" 2>/dev/null || true)"
[[ -n "$FILE_PATH" ]] || exit 0
[[ -f "$FILE_PATH" ]] || exit 0

FILE_PATH="$(realpath -m "$FILE_PATH")"

# Walk up from the file looking for a live socket, matching the SESSION_NAME
# derivation in home/.local/bin/code exactly (basename with '.', ' ', ':' -> '_').
SOCKET=""
dir="$(dirname "$FILE_PATH")"
while [[ -n "$dir" && "$dir" != "/" ]]; do
  name="$(basename "$dir" | tr '.' '_' | tr ' ' '_' | tr ':' '_')"
  candidate="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-arch-nvim-${name}.sock"
  if [[ -S "$candidate" ]]; then
    SOCKET="$candidate"
    break
  fi
  dir="$(dirname "$dir")"
done
[[ -n "$SOCKET" ]] || exit 0

VIM_ESCAPED_PATH="${FILE_PATH//\'/\'\'}"

# Lua chunk run inside the target Neovim via --remote-expr's luaeval(). Kept
# free of single quotes so it can be dropped straight into the Vimscript
# string literal below without escaping.
LUA_BODY=$(cat <<'LUA'
(function()
  local f = _A
  local tab = vim.api.nvim_get_current_tabpage()
  local function is_tree(buf)
    return vim.bo[buf].filetype == "NvimTree"
  end
  local existing = vim.fn.bufnr(f)
  if existing ~= -1 then
    for _, w in ipairs(vim.api.nvim_tabpage_list_wins(tab)) do
      if vim.api.nvim_win_get_buf(w) == existing then
        vim.api.nvim_set_current_win(w)
        if not vim.bo[existing].modified then
          vim.cmd("checktime " .. existing)
        end
        return 1
      end
    end
  end
  local buf = vim.fn.bufnr(f, true)
  vim.fn.bufload(buf)
  vim.cmd("checktime " .. buf)
  local target = nil
  for _, w in ipairs(vim.api.nvim_tabpage_list_wins(tab)) do
    if not is_tree(vim.api.nvim_win_get_buf(w)) then
      target = w
      break
    end
  end
  if not target then
    vim.cmd("vsplit")
    target = vim.api.nvim_get_current_win()
  end
  vim.api.nvim_win_set_buf(target, buf)
  vim.api.nvim_set_current_win(target)
  return 1
end)()
LUA
)

REMOTE_EXPR="luaeval('${LUA_BODY}', '${VIM_ESCAPED_PATH}')"

nvim --server "$SOCKET" --remote-expr "$REMOTE_EXPR" >/dev/null 2>&1 || true

exit 0
