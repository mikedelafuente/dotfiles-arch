#!/bin/bash
# Command picker for the dfa-* helpers — pick one with fzf, see what it does,
# and run it. Grouped by purpose, with routine maintenance first.
#
# Usage:
#   dfa              interactive fzf picker, runs the selected command
#   dfa list         print the same table, no fzf, no execution
#   dfa <name> [args…]  skip the picker, run dfa-<name> (or the alias) directly
#
# Extra args after the command name are forwarded to the picked command, e.g.: dfa sync-dotfiles --yes

set -uo pipefail

_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "/proc/$$/fd/255" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
[[ -r "$_LIB_DIR/dotfiles-arch-lib.sh" ]] && source "$_LIB_DIR/dotfiles-arch-lib.sh"

# name | group | badge | how-often | one-line summary | longer explanation (used in fzf preview)
#
# "badge" is a short (~1-3 word) tag for the picker row itself — the row has
# no room for prose, so it never truncates mid-sentence. "how-often" is the
# fuller cadence/trigger text shown in the preview pane's "How often" line.
#
# Groups stay contiguous so related commands are easy to find and search.
DFA_COMMANDS=(
  "daily|Routine|Everyday updates|Daily, with a clean dotfiles checkout|Get latest shared changes and run routine updates|Your usual choice. Pulls clean repos, deploys latest dotfiles, then runs migrations, package/app updates and skills/rules/model-list sync. Native updates have a 24-hour cooldown. If dotfiles-arch has uncommitted changes, daily stops before package maintenance; use deploy or sync-dotfiles to test those edits, then commit or stash before running daily. Weekly includes daily, so choose one routine per run."
  "weekly|Routine|Weekly maintenance|Weekly, instead of daily|Daily updates plus forced updates and cleanup preview|Choose about once a week instead of daily. Runs the full daily routine, then forces a native/app update past the cooldown, previews orphan packages and checks NinjaOne health. Dirty dotfiles or a failed daily gate also stop weekly. Cleanup needs a separate dfa remove-orphans --remove confirmation."
  "sync-sources|AI|Add / remove sources|When managing shared AI configuration|Manage rules, skills, and extensions sources|Opens an interactive manager to view, add, remove, or reorder local source directories, and apply changes. dotfiles-arch is always included. Add a cloned repo with rules/, skills/, or extensions/ subfolders (standard), or choose skills-root / rules-root / extensions-root for a directory containing those items directly. Later sources override earlier ones on name collisions. CLI: dfa sync-sources list; dfa sync-sources add /path/to/repo; dfa sync-sources remove /path/to/repo. Removing a source unregisters it and prunes managed links; the source directory stays on disk."
  "sync-skills|AI|Daily · via daily|Daily (via dfa-daily)|Relink personal skills from dotfiles-arch|Deploys installed skill copies from dotfiles-arch plus any extra sources (dfa-sync-sources) into Claude, Cursor, detected Codex, and Pi skill dirs, pruning stale links. Part of dfa-daily; run alone after editing a skill locally if you don't want a full daily run."
  "sync-rules|AI|Daily · via daily|Daily (via dfa-daily)|Relink personal rules from dotfiles-arch|Syncs rules into Cursor and always-apply rules into Claude, detected Codex, and Pi global agent files, pruning stale links. Part of dfa-daily; run alone after editing a rule locally."
  "sync-extensions|AI|Daily · via daily|Daily (via dfa-daily)|Relink Pi extensions from dotfiles-arch|Symlinks extensions/* from dotfiles-arch plus any extra sources into ~/.pi/agent/extensions, pruning stale links. Part of dfa-daily; run alone after editing an extension locally."
  "sync-harness-agents|AI|Daily · via daily|Daily (via dfa-daily)|Sync locally-pulled Ollama models into Codex + opencode's model lists|Regenerates the managed ollama-* profile/provider blocks in ~/.codex/config.toml and ~/.config/opencode/opencode.jsonc from 'ollama list'. Part of dfa-daily; run alone right after an 'ollama pull'/'ollama rm' if you don't want to wait for the next daily run."
  "update-npm-clis|AI|Daily · via daily|Daily (via dfa-daily)|Update npm-owned agent CLIs and recognized native Claude|setup-claude.sh/setup-codex.sh/setup-pi.sh only npm-install these when missing, so they'd otherwise never update in place. Ubuntu opencode-ai uses user npm; Arch opencode stays with dfa-update-system. Recognized user-native Claude uses claude update even without NVM/npm. Unowned installed launchers or unavailable npm owners fail the daily summary. Other non-npm or shadowing launchers remain source conflicts; no duplicate npm copy is installed."
  "repos|Projects|Often|Whenever you're jumping between projects|Pick a repo under ~/repos with fzf and cd into it|Prints the picked path — use as: cd \"\$(dfa-repos)\" (the r alias does this for you). Two levels deep, .git-aware; also lists non-git folders as browse targets."
  "update-repos|Projects|Daily · via daily|Daily (via dfa-daily)|git pull --ff-only every repo under ~/repos, in parallel|Skips any repo with a dirty working tree; MAX_PARALLEL (default 8) controls concurrency. This is the step in dfa-daily that notices when dotfiles-arch itself has new commits."
  "deploy|Dotfiles|Test config edits|After editing configs, rules or skills|Apply local config edits; no pull, installs or setup|Choose this for shell/editor settings, rules or skills. Snapshots your checkout including uncommitted changes, validates and activates installed copies. Does not fetch or run package/setup scripts. Choosing this row runs dfa-deploy deploy. Advanced recovery: dfa deploy source; capture <artifact>; override <artifact> <file>; rebind <checkout>; rollback; recover. Use sync-dotfiles for setup-script changes, daily for latest shared changes, weekly for extra maintenance. Conflicts preserve the active configuration."
  "sync-dotfiles|Dotfiles|Test setup edits|After changing setup scripts or repairing an installation|Apply local edits and rerun workstation setup|Choose when you changed a setup script, added an app or need to repair setup. Deploys local uncommitted changes without pulling, then runs guarded native/app updates, your profile setup scripts, links and post-link hooks. Needs sudo. For config/rule/skill edits alone, deploy is enough. For latest shared changes, choose daily."
  "migrate|Dotfiles|Daily · via daily|Daily (via dfa-daily)|Apply any pending dotfiles-arch schema migrations|Renames in home/.local/bin leave dangling ~/.local/bin symlinks that link-dotfiles.sh never prunes, so each schema bump ships a migrations/vN-to-vM-migration.sh. This walks from the version recorded in ~/.config/dotfiles-arch/.dotfiles_schema_version up to the repo's, running each one and re-stamping after each. A machine with no recorded version has it inferred from which leftover symlink is present. Part of dfa-daily, right after dfa-update-repos so a fresh pull's migrations apply the same run. --dry-run reports without running; --rerun-all replays every migration."
  "check-dotfiles|Dotfiles|Pre-commit|Before committing a script change|Syntax-check + shellcheck the dotfiles-arch scripts|Runs scripts/check.sh (bash -n + shellcheck -x) over the repo. Aliased as: check."
  "update-system|System|Daily · via daily|Daily (via dfa-daily)|Native Arch/APT updates plus verified CLI and desktop utility releases|Rate-limited native updater: Arch pacman plus scanned AUR dependencies; Ubuntu APT retains holds/pins and refuses removals. --scan-only is diagnostic on Ubuntu; managed upstream Neovim/tree-sitter/lazydocker/minikube/kubectl/k9s refresh after native updates; Ubuntu Chrome/Slack/TablePlus/Spotify use scoped vendor APT; Zoom/Orca/Obsidian DEBs and pinned Keymapp refresh explicitly; Postman/Spotify Snaps retain automatic refresh/holds; Postman user archives retain in-app updates. Changed Keymapp bytes require reviewed pins; failed steps never stamp success. dfa-daily always runs this; run it alone if you just want packages current without touching repos or skills/rules. Also force-run weekly (via dfa-weekly) to bypass the cooldown."
  "install-ninjaone|System|Once|Once per work machine, when NinjaOne is mandated|Install opt-in NinjaOne (native Ubuntu DEB / Arch repackaging)|Takes the installer .deb URL from the NinjaOne console (--url, NINJAONE_INSTALLER_URL, or a hidden prompt), pins the host without redirects, verifies the archive layout, installs a native Ubuntu DEB or local Arch package, and saves the URL to ~/.config/dotfiles-arch/ninjaone.env (mode 600, never committed). Work profile only unless --force. Existing IT-managed installs retained. Arch is unsupported by NinjaOne."
  "uninstall-ninjaone|System|Rarely|When NinjaOne/SentinelOne needs a clean reset or removal|Remove owned NinjaOne; Ubuntu SentinelOne removal is separately requested|Requires a terminal and typing remove; --yes is insufficient. Ubuntu uses the owned agent vendor uninstaller and retains SentinelOne unless --remove-sentinelone is separately confirmed with its hidden console passphrase. Arch retains its existing repackaged agent/SentinelOne cleanup. Deletes the saved installer URL unless --keep-url. Unknown/IT-managed NinjaOne retained. The device record stays in the NinjaOne console until an admin deletes it."
  "update-ninjaone|System|Weekly · via weekly|Weekly (via dfa-weekly), or with --url when IT hands you a newer installer|Native NinjaOne health; --url upgrades our matching enrollment|The agent upgrades itself via ninjarmm-patcher.timer, so this only checks that the agent service and patcher timer are healthy and reinstalls from the saved URL if the binary is missing. --url <newer URL> upgrades only if that version is newer than what is on disk. IT-managed installations receive read-only health checks; changes belong to IT/vendor. Does nothing when the agent was never installed."
  "remove-orphans|System|Weekly · via weekly|Weekly (via dfa-weekly), or occasionally after removing packages by hand|Preview native orphan/removal candidates|Aliased as: orphans. Arch uses pacman recursive removal planning; Ubuntu uses APT autoremove simulation. --remove requires typing remove in a terminal; --yes/--force do not authorize removal."
  "refresh-audio|System|On dock event|After docking/undocking or resuming from suspend|Restart the active PipeWire/WirePlumber stack to clear duplicate audio devices|Requires loaded, active wireplumber, pipewire and pipewire-pulse user services on either distro; reports missing/masked/inactive services before any restart. --status only prints wpctl status and propagates its failure."
)

DFA_GUIDE=$'Everyday: daily | Weekly: weekly (includes daily)\nLocal config edits: deploy | Setup/script changes: sync-dotfiles\nDaily/weekly need a clean dotfiles checkout; deploy/sync test uncommitted edits.'

usage() {
  cat <<'EOF'
Usage: dfa [list | <name> [args…]]

With no arguments, opens an fzf picker over the dfa-* helper commands —
grouped into Routine, AI, Projects, Dotfiles, and System — with a preview
pane explaining what each does and when to prefer it. Selecting one runs it.

  dfa daily            latest shared changes + routine updates (clean checkout)
  dfa weekly           daily + forced updates and cleanup preview
  dfa deploy           test local config/rule/skill edits; no commit or pull
  dfa sync-dotfiles     test setup edits; rerun setup and guarded package updates

  dfa list             print the same table without fzf or execution
  dfa <name> [args…]   run dfa-<name> (or its short alias) directly, e.g.
                        dfa sync-dotfiles --yes
  dfa -h | --help       this message
EOF
}

resolve_command() {
  # Generic fallback prefixes "dfa-" onto whatever name was typed; the case
  # arms below are for names that don't map that way — old pre-rename names
  # kept working, plus the two documented short aliases.
  local name="$1"
  case "$name" in
    morning) echo "dfa-daily" ;;
    check) echo "dfa-check-dotfiles" ;;
    orphans) echo "dfa-remove-orphans" ;;
    dfa-*) echo "$name" ;;
    *) echo "dfa-$name" ;;
  esac
}

print_table() {
  local entry name group badge freq short
  printf '%s\n\n' "$DFA_GUIDE"
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name group badge freq short _ <<<"$entry"
    printf '%-10s %-24s %s\n' "$group" "dfa-$name" "$short"
  done
}

preview_for() {
  local target="$1" entry name group badge freq short long width="${FZF_PREVIEW_COLUMNS:-76}"
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name group badge freq short long <<<"$entry"
    if [[ "$name" == "$target" ]]; then
      printf 'dfa-%s · %s\n\n%s\n\nHow often: %s\n\n%s\n' "$name" "$group" "$short" "$freq" "$long" | fold -s -w "$width"
      return 0
    fi
  done
  printf 'No description for %s\n' "$target"
}

run_picker() {
  if ! command -v fzf &>/dev/null; then
    echo "fzf is not installed. Available commands:" >&2
    print_table >&2
    exit 1
  fi
  if [[ ! -t 0 ]] || [[ ! -t 2 ]]; then
    echo "dfa needs an interactive terminal to pick — pass a name directly (dfa <name>) or use 'dfa list'." >&2
    exit 1
  fi

  # Keep the command in field 1 for preview/dispatch; display the group
  # first using tab-delimited fields. Searching "AI" finds every AI helper.
  local entry name group badge lines=()
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name group badge _ _ _ <<<"$entry"
    lines+=("$(printf 'dfa-%s\t%-10s\t%-24s\t%s' "$name" "$group" "dfa-$name" "$badge")")
  done

  clear >/dev/tty

  # Side-by-side preview needs room for both the list and readable prose;
  # below that width, stack the preview under the list instead so its text
  # wraps at full terminal width rather than clipping in a squeezed column.
  local cols preview_window
  cols="$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")"
  if (( cols >= 140 )); then
    preview_window='right:50%'
  else
    preview_window='down:55%'
  fi

  local selected
  selected="$(printf '%s\n' "${lines[@]}" \
    | fzf --height=70% --layout=reverse --border \
          --delimiter=$'\t' --with-nth=2.. --tabstop=2 --no-sort \
          --prompt='dfa> ' \
          --header=$'Enter: run · Esc: cancel\n'"$DFA_GUIDE" \
          --preview="echo {1} | sed 's/^dfa-//' | xargs -I{} \"$0\" __preview__ {}" \
          --preview-window="$preview_window")"

  [[ -z "$selected" ]] && exit 0
  cut -f1 <<<"$selected"
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    list) print_table; exit 0 ;;
    __preview__) preview_for "$2"; exit 0 ;;
  esac

  local chosen cmd
  if [[ $# -gt 0 ]]; then
    chosen="$1"
    shift
    cmd="$(resolve_command "$chosen")"
  else
    chosen="$(run_picker)"
    [[ -z "$chosen" ]] && exit 0
    cmd="$chosen"
  fi

  # The deploy row applies configuration; explicit subcommands still pass through.
  if [[ "$cmd" == dfa-deploy && $# -eq 0 ]]; then set -- deploy; fi

  if ! command -v "$cmd" &>/dev/null; then
    echo "dfa: $cmd not found on PATH" >&2
    exit 1
  fi

  exec "$cmd" "$@"
}

main "$@"
