#!/bin/bash
# Command picker for the dfa-* helpers — pick one with fzf, see what it does,
# and run it. Ordered by roughly how often you'd reach for it, most common
# first, so the picker itself builds the habit of using the right one.
#
# Usage:
#   dfa              interactive fzf picker, runs the selected command
#   dfa list         print the same table, no fzf, no execution
#   dfa <name> [args…]  skip the picker, run dfa-<name> (or the alias) directly
#
# Extra args after the command name (or typed at the fzf prompt as a query)
# are forwarded to the picked command, e.g.: dfa sync-dotfiles --yes

set -uo pipefail

_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
[[ -r "$_LIB_DIR/dotfiles-arch-lib.sh" ]] && source "$_LIB_DIR/dotfiles-arch-lib.sh"

# name | badge | how-often | one-line summary | longer explanation (used in fzf preview)
#
# "badge" is a short (~1-3 word) tag for the picker row itself — the row has
# no room for prose, so it never truncates mid-sentence. "how-often" is the
# fuller cadence/trigger text shown in the preview pane's "How often" line.
#
# Ordered most-to-least frequent. "How often" is a rough habit guide, not a
# hard rule — edit freely as your own routine settles.
DFA_COMMANDS=(
  "daily|Daily|Daily|Your one command each day: pull repos, update packages, resync skills/rules/agents|Runs dfa-update-repos, dfa-update-system, dfa-update-npm-clis, dfa-sync-skills, dfa-sync-rules, dfa-sync-harness-agents in order (edit DAILY_STEPS in ~/.local/bin/dfa-daily to change the list). If dfa-update-repos pulls new dotfiles-arch commits, it automatically runs dfa-sync-dotfiles for you and restarts once so the remaining steps see the freshly-synced scripts. This is the everyday driver — you almost never need to reach for the individual steps below by hand. For weekly maintenance on top (orphan cleanup, a forced package-update pass), see dfa-weekly."
  "weekly|Weekly|Weekly|Runs dfa-daily, then removes orphaned packages and forces a package-update pass|Runs dfa-daily first (all 6 daily steps, plus its own dotfiles-arch auto-resync), then dfa-update-system --force (bypasses the 24h cooldown, to catch anything daily's throttling skipped) and dfa-remove-orphans (pacman -Qtdq cleanup, needs sudo). Reach for this about once a week instead of dfa-daily to keep the machine fully current and free of orphaned packages."
  "sync-dotfiles|As needed|After editing dotfiles-arch, or if daily's auto-resync fails|Apply THIS repo's setup scripts + symlinks to your machine|Re-runs the setup-*.sh scripts for your saved profile and re-links home/ + config/ into \$HOME (scripts/sync.sh). dfa-daily already calls this automatically whenever it notices dotfiles-arch itself moved forward. Run it directly only when you want that applied right now without also updating packages/repos — e.g. you just committed a setup-script change on this machine, or dfa-daily's auto-resync step failed and you want to retry it alone."
  "update-repos|Daily · via daily|Daily (via dfa-daily)|git pull --ff-only every repo under ~/repos, in parallel|Skips any repo with a dirty working tree; MAX_PARALLEL (default 8) controls concurrency. This is the step in dfa-daily that notices when dotfiles-arch itself has new commits."
  "update-system|Daily · via daily|Daily (via dfa-daily)|Guarded pacman + yay update, with an AUR IoC scan|Rate-limited day-to-day system package updater. dfa-daily always runs this; run it alone if you just want packages current without touching repos or skills/rules. Also force-run weekly (via dfa-weekly) to bypass the cooldown."
  "update-npm-clis|Daily · via daily|Daily (via dfa-daily)|npm update -g the npm-installed agent CLIs (claude, codex, pi)|setup-claude.sh/setup-codex.sh/setup-pi.sh only npm-install these when missing, so they'd otherwise never update in place. opencode is excluded — it's a pacman package, already refreshed by dfa-update-system. Skips quietly if NVM/npm isn't available."
  "sync-skills|Daily · via daily|Daily (via dfa-daily)|Relink personal Claude/Cursor skills from dotfiles-arch|Symlinks skills/* from dotfiles-arch plus any extra sources (dfa-sync-sources) into ~/.claude/skills and ~/.cursor/skills, pruning stale links. Part of dfa-daily; run alone after editing a skill locally if you don't want a full daily run."
  "sync-rules|Daily · via daily|Daily (via dfa-daily)|Relink personal Cursor rules from dotfiles-arch|Symlinks rules/* from dotfiles-arch plus extra sources into ~/.cursor/rules (and, for alwaysApply rules, a ~/.claude/dfa-rules-*.md import), pruning stale links. Part of dfa-daily; run alone after editing a rule locally."
  "sync-harness-agents|Daily · via daily|Daily (via dfa-daily)|Sync locally-pulled Ollama models into Codex + opencode's model lists|Regenerates the managed ollama-* profile/provider blocks in ~/.codex/config.toml and ~/.config/opencode/opencode.jsonc from 'ollama list'. Part of dfa-daily; run alone right after an 'ollama pull'/'ollama rm' if you don't want to wait for the next daily run."
  "repos|Often|Whenever you're jumping between projects|Pick a repo under ~/repos with fzf and cd into it|Prints the picked path — use as: cd \"\$(dfa-repos)\" (the r alias does this for you). Two levels deep, .git-aware; also lists non-git folders as browse targets."
  "refresh-audio|On dock event|After docking/undocking or resuming from suspend|Restart the PipeWire/WirePlumber stack to clear duplicate audio devices|Restarts wireplumber, pipewire, and pipewire-pulse (user services) — fixes duplicate sink/source entries in wpctl status and GNOME's speaker/mic quick-settings menus. --status just prints wpctl status without restarting anything."
  "remove-orphans|Weekly · via weekly|Weekly (via dfa-weekly), or occasionally after removing packages by hand|Remove orphaned pacman packages (pacman -Qtdq)|Aliased as: orphans."
  "check-dotfiles|Pre-commit|Before committing a script change|Syntax-check + shellcheck the dotfiles-arch scripts|Runs scripts/check.sh (bash -n + shellcheck -x) over the repo. Aliased as: check."
  "sync-sources|Rare|Rare — one-time setup per extra source repo|List, add, or remove extra rules/skills source repos|Manages ~/.config/dotfiles-arch/sync-sources, the list of non-dotfiles-arch repos that dfa-sync-skills / dfa-sync-rules also pull from."
)

usage() {
  cat <<'EOF'
Usage: dfa [list | <name> [args…]]

With no arguments, opens an fzf picker over the dfa-* helper commands —
ordered by how often you'd typically reach for each one — with a preview
pane explaining what each does and when to prefer it. Selecting one runs it.

  dfa list             print the same table without fzf or execution
  dfa <name> [args…]   run dfa-<name> (or its short alias) directly, e.g.
                        dfa sync-dotfiles --yes
  dfa -h | --help       this message
EOF
}

resolve_command() {
  # Generic fallback prefixes "dfa-" onto whatever name was typed; the case
  # arms below are for names that don't map that way — old pre-rename names
  # kept working, plus the two documented short aliases.
  local name="$1"
  case "$name" in
    morning) echo "dfa-daily" ;;
    check) echo "dfa-check-dotfiles" ;;
    orphans) echo "dfa-remove-orphans" ;;
    dfa-*) echo "$name" ;;
    *) echo "dfa-$name" ;;
  esac
}

print_table() {
  local entry name badge freq short
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name badge freq short _ <<<"$entry"
    printf '%-22s %-30s %s\n' "dfa-$name" "$freq" "$short"
  done
}

preview_for() {
  local target="$1" entry name badge freq short long width="${FZF_PREVIEW_COLUMNS:-76}"
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name badge freq short long <<<"$entry"
    if [[ "$name" == "$target" ]]; then
      printf 'dfa-%s\n\nHow often: %s\n\n%s\n' "$name" "$freq" "$long" | fold -s -w "$width"
      return 0
    fi
  done
  printf 'No description for %s\n' "$target"
}

run_picker() {
  if ! command -v fzf &>/dev/null; then
    echo "fzf is not installed. Available commands:" >&2
    print_table >&2
    exit 1
  fi
  if [[ ! -t 0 ]] || [[ ! -t 2 ]]; then
    echo "dfa needs an interactive terminal to pick — pass a name directly (dfa <name>) or use 'dfa list'." >&2
    exit 1
  fi

  # Row = name + a short status badge only. The full "how often" text and
  # the long explanation live in the preview pane, not the row — a row that
  # also tried to fit a one-line summary (or a full-sentence badge) is what
  # used to truncate into "··" at normal terminal widths. The name column
  # width is sized to the longest command name so the badge always lines up
  # in its own column instead of butting up against a long name.
  local entry name badge name_w=0 lines=()
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name _ _ _ _ <<<"$entry"
    (( ${#name} + 6 > name_w )) && name_w=$(( ${#name} + 6 ))
  done
  for entry in "${DFA_COMMANDS[@]}"; do
    IFS='|' read -r name badge _ _ _ <<<"$entry"
    lines+=("$(printf "%-${name_w}s %s" "dfa-$name" "$badge")")
  done

  clear >/dev/tty

  # Side-by-side preview needs room for both the list and readable prose;
  # below that width, stack the preview under the list instead so its text
  # wraps at full terminal width rather than clipping in a squeezed column.
  local cols preview_window
  cols="$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")"
  if (( cols >= 100 )); then
    preview_window='right:60%'
  else
    preview_window='down:55%'
  fi

  local selected
  selected="$(printf '%s\n' "${lines[@]}" \
    | fzf --height=70% --layout=reverse --border \
          --prompt='dfa> ' \
          --header='pick a command — preview explains what it does and when to use it' \
          --preview="echo {1} | sed 's/^dfa-//' | xargs -I{} \"$0\" __preview__ {}" \
          --preview-window="$preview_window")"

  [[ -z "$selected" ]] && exit 0
  awk '{print $1}' <<<"$selected"
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    list) print_table; exit 0 ;;
    __preview__) preview_for "$2"; exit 0 ;;
  esac

  local chosen cmd
  if [[ $# -gt 0 ]]; then
    chosen="$1"
    shift
    cmd="$(resolve_command "$chosen")"
  else
    chosen="$(run_picker)"
    [[ -z "$chosen" ]] && exit 0
    cmd="$chosen"
  fi

  if ! command -v "$cmd" &>/dev/null; then
    echo "dfa: $cmd not found on PATH" >&2
    exit 1
  fi

  exec "$cmd" "$@"
}

main "$@"
