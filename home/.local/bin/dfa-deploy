#!/bin/bash
# Stage/deploy installed copies, manage source provenance, overrides and recovery.
set -euo pipefail
_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "/proc/$$/fd/255" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$_LIB_DIR/dotfiles-arch-lib.sh"
ROOT="$(resolve_dotfiles_arch)" || exit 1
# shellcheck source=/dev/null
source "$ROOT/scripts/dotheader.sh"
exec python3 "$ROOT/scripts/deployment.py" "$@"
