#!/bin/bash
# Day-to-day guarded pacman + yay updater (AUR IoC scan).
# Usage: update-system [--yes|-y] [--scan-only] [-h]

set -euo pipefail

resolve_dotfiles_arch() {
  local d candidates=()
  if [[ -n "${DOTFILES_ARCH:-}" ]]; then
    candidates+=("$DOTFILES_ARCH")
  fi
  candidates+=(
    "$HOME/repos/dotfiles-arch"
    "$HOME/dotfiles-arch"
    "$HOME/src/dotfiles-arch"
  )
  # If this file is a symlink into the repo, walk up from it
  local self
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "")"
  if [[ -n "$self" ]]; then
    candidates+=("$(cd "$(dirname "$self")/../../.." && pwd)")
  fi
  for d in "${candidates[@]}"; do
    if [[ -f "$d/scripts/update-system.sh" ]]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

ROOT="$(resolve_dotfiles_arch)" || {
  echo "Could not find dotfiles-arch (set DOTFILES_ARCH=/path/to/dotfiles-arch)." >&2
  exit 1
}

exec bash "$ROOT/scripts/update-system.sh" "$@"
