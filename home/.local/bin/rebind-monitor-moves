#!/usr/bin/env bash
# Rebind Super+Ctrl+Up/Down for moving windows between monitors.
#
# Pop Shell tiling and Mutter cannot share the same chord (double-fire snap-back).
# - tile-by-default true  → Pop Shell pop-monitor-* (tiled moves)
# - tile-by-default false → Mutter move-to-monitor-* (floating / maximized)
#
# Usage:
#   rebind-monitor-moves           # apply once
#   rebind-monitor-moves --watch   # apply, then re-apply when Super+Y toggles tiling

set -euo pipefail

POP_SCHEMA="org.gnome.shell.extensions.pop-shell"
WM_SCHEMA="org.gnome.desktop.wm.keybindings"
CHORD_LEFT="['<Primary><Super>Up']"
CHORD_RIGHT="['<Primary><Super>Down']"

rebind() {
  local tiling
  tiling="$(gsettings get "$POP_SCHEMA" tile-by-default)"

  # Always clear geometric up/down (side-by-side monitors use left/right hops).
  gsettings set "$POP_SCHEMA" pop-monitor-up "[]"
  gsettings set "$POP_SCHEMA" pop-monitor-down "[]"
  gsettings set "$WM_SCHEMA" move-to-monitor-up "[]"
  gsettings set "$WM_SCHEMA" move-to-monitor-down "[]"

  if [[ "$tiling" == "true" ]]; then
    gsettings set "$POP_SCHEMA" pop-monitor-left "$CHORD_LEFT"
    gsettings set "$POP_SCHEMA" pop-monitor-right "$CHORD_RIGHT"
    gsettings set "$WM_SCHEMA" move-to-monitor-left "[]"
    gsettings set "$WM_SCHEMA" move-to-monitor-right "[]"
  else
    gsettings set "$POP_SCHEMA" pop-monitor-left "[]"
    gsettings set "$POP_SCHEMA" pop-monitor-right "[]"
    gsettings set "$WM_SCHEMA" move-to-monitor-left "$CHORD_LEFT"
    gsettings set "$WM_SCHEMA" move-to-monitor-right "$CHORD_RIGHT"
  fi
}

rebind

if [[ "${1:-}" != "--watch" ]]; then
  exit 0
fi

if ! command -v dconf >/dev/null 2>&1; then
  echo "dconf not found; cannot watch tile-by-default" >&2
  exit 1
fi

# Re-apply whenever Pop Shell toggles tiling (Super+Y).
dconf watch /org/gnome/shell/extensions/pop-shell/tile-by-default | while read -r _; do
  rebind
done
