#!/bin/bash
# Morning routine — refresh git repos and system packages.
#
# Edit MORNING_STEPS below to add or reorder tasks. Each name must be on PATH
# (~/.local/bin). Missing commands are skipped with a message.
#
# Default: update-repos, then update-system (day-to-day pacman + yay), then
# sync-skills (relink personal skills from dotfiles-arch), then sync-rules
# (relink personal Cursor rules from dotfiles-arch).
# Use sync-dotfiles instead of (or after) update-system when the dotfiles repo
# changed and you want setup scripts + re-link, not just package upgrades.
# morning does not run setup-*.sh itself (that's what sync-dotfiles is for) —
# it only nudges you to run sync-dotfiles when update-repos pulled new
# dotfiles-arch commits.
#
# Usage: morning [args…]
#   Args are forwarded to every step (e.g. morning --yes).

set -uo pipefail

_MORNING_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_MORNING_LIB_DIR="$(cd -- "$(dirname -- "$_MORNING_SELF")" &>/dev/null && pwd)"
if [[ -r "$_MORNING_LIB_DIR/dotfiles-arch-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_MORNING_LIB_DIR/dotfiles-arch-lib.sh"
fi

MORNING_STEPS=(
  update-repos
  update-system
  sync-skills
  sync-rules
)

usage() {
  cat <<'EOF'
Usage: morning [args…]

Run the morning routine steps in order. Edit MORNING_STEPS in this script to
customize. Steps not on PATH are skipped.

Default steps:
  update-repos    git pull under ~/repos
  update-system   guarded pacman + yay update
  sync-skills     relink skills from dotfiles-arch + sync-sources extras
  sync-rules      relink Cursor rules from dotfiles-arch + sync-sources extras

Example:
  morning --yes   non-interactive system update (forwarded to update-system)
EOF
}

main() {
  local step
  local -a failures=() skipped=()
  local dotfiles_arch_root="" before_sha="" after_sha=""

  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        usage
        exit 0
        ;;
    esac
  done

  if command -v resolve_dotfiles_arch &>/dev/null; then
    dotfiles_arch_root="$(resolve_dotfiles_arch 2>/dev/null || true)"
    if [[ -n "$dotfiles_arch_root" ]]; then
      before_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
    fi
  fi

  for step in "${MORNING_STEPS[@]}"; do
    if ! command -v "$step" &>/dev/null; then
      printf 'morning: skip %s (not on PATH)\n' "$step" >&2
      skipped+=("$step")
      continue
    fi

    printf '\n==> %s\n' "$step"
    if "$step" "$@"; then
      :
    else
      printf 'morning: %s failed (exit %s)\n' "$step" "$?" >&2
      failures+=("$step")
    fi
  done

  if [[ -n "$dotfiles_arch_root" ]]; then
    after_sha="$(git -C "$dotfiles_arch_root" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n "$before_sha" && -n "$after_sha" && "$before_sha" != "$after_sha" ]]; then
      printf '\nmorning: dotfiles-arch updated (%s..%s) — run sync-dotfiles to apply setup script changes\n' \
        "${before_sha:0:7}" "${after_sha:0:7}"
    fi
  fi

  printf '\n'
  if ((${#skipped[@]})); then
    printf 'morning: skipped (not on PATH): %s\n' "${skipped[*]}"
  fi
  if ((${#failures[@]})); then
    printf 'morning: finished with failures: %s\n' "${failures[*]}" >&2
    exit 1
  fi
  printf 'morning: done\n'
}

main "$@"
