#!/bin/bash
# Bring this machine up to the repo's dotfiles-arch schema version, running any
# pending migrations/vN-to-vM-migration.sh in order.
# Usage: dfa-migrate [--dry-run] [--rerun-all]

set -euo pipefail

_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
source "$_LIB_DIR/dotfiles-arch-lib.sh"

ROOT="$(resolve_dotfiles_arch)" || {
  echo "Could not find dotfiles-arch (set DOTFILES_ARCH=/path/to/dotfiles-arch)." >&2
  exit 1
}

exec bash "$ROOT/scripts/migrate.sh" "$@"
