#!/bin/bash
# Preview native orphan/removal candidates; --remove requires confirmation.
# Usage: dfa-remove-orphans [--remove] [--yes] [--force]

set -euo pipefail

_LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f "/proc/$$/fd/255" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck source=/dev/null
source "$_LIB_DIR/dotfiles-arch-lib.sh"

ROOT="$(resolve_dotfiles_arch)" || {
  echo "Could not find dotfiles-arch (set DOTFILES_ARCH=/path/to/dotfiles-arch)." >&2
  exit 1
}

# shellcheck source=/dev/null
source "$ROOT/scripts/dotheader.sh"

remove_orphaned_packages "$@"
