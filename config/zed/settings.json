// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  // Claude Code ships no Zed extension, so its `/ide` command can never bind
  // to Zed. These registry agents are the supported bridge: the same CLIs
  // reached over ACP, with file context, diffs and edits inside this window.
  // Zed 1.18 has no settings key for which agent the Agent Panel preselects.
  // Pick one from the panel's new-thread menu.
  "agent_servers": {
    "codex": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "thinking_display": "always_expanded",
    "dock": "right",
    "default_profile": "ask",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    },
    "model_parameters": [],
    // Runs when a new Terminal Thread starts (Agent Panel "+" -> Terminal),
    // giving Zed a `dev --tmux`-style agent pane: it resolves the same
    // DEFAULT_HARNESS (see home/.local/bin/zed-agent-init) instead of
    // hardcoding `claude` or `codex`, so both stay in sync with the choice
    // made in setup-dev.sh.
    "terminal_init_command": "zed-agent-init"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato"
  }
}
